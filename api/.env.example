# Server-only environment variables. Never expose these with a VITE_ prefix.
PORT=8080
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# OpenAI-compatible endpoint. Use only a provider/model with a verified free allowance.
# Leave unset until a genuinely free provider is selected and configured.
AI_API_BASE_URL=
AI_PROVIDER_VERIFIED_FREE=false\nAI_API_KEY=
AI_MODEL=
AI_DAILY_COST_CAP_USD=0
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=800
MAX_MESSAGES_PER_MINUTE=5
MAX_REQUESTS_PER_IP_PER_MINUTE=20
